# Godot 4
.godot/

# Sibling addons, linked for the suite (see README):
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
#   ln -s ../../gs-bot/addons/gs_bot addons/gs_bot
/addons/gs_core
/addons/gs_bot
# gs-bot's own dependencies:
/addons/gs_sql
/addons/godot-sqlite
/addons/gs_bot_record
# The snapshot suite's (examples/snapshot_selftest): gs-net and its profiler.
/addons/gs_net
/addons/gs_profile
# The arms parity test's script (examples/sim_selftest): gs-player-char's clearance scan.
#   ln -s ../../../gs-player-char/addons/gs_player_char/nodes/gs_view_arms_clear.gd examples/linked/
/examples/linked/
# The weapon parity test's addon (examples/sim_selftest): gs-weapon.
#   ln -s ../../gs-weapon/addons/gs_weapon addons/gs_weapon
/addons/gs_weapon
# gs-weapon's own dependency:
/addons/gs_combat

# The built library and its .gdextension, written by ci/install.sh; never committed.
/addons/gs_sim/bin/
/addons/gs_sim/gs_sim.gdextension
/addons/gs_sim/gs_sim.gdextension.uid

# Rust
rust/target/
rust/vendor/*/target/
rust/vendor/*/Cargo.lock

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Release packaging output (ci/package.sh).
dist/
